# Wazuh Manager - bake in configs and boot hooks
FROM wazuh/wazuh-manager:4.8.0

COPY wazuh-config/ossec.conf /var/ossec/etc/ossec.conf

RUN mkdir -p /entrypoint-scripts /var/ossec/etc/shared/default && \
    touch /var/ossec/etc/shared/ar.conf && \
    touch /var/ossec/etc/shared/default/agent.conf && \
    chown -R root:wazuh /var/ossec/etc/shared && \
    chmod -R 770 /var/ossec/etc/shared

RUN printf '#!/bin/bash\nmkdir -p /var/ossec/etc/shared/default\ntouch /var/ossec/etc/shared/ar.conf\ntouch /var/ossec/etc/shared/default/agent.conf\nchown -R root:wazuh /var/ossec/etc/shared\nchmod -R 770 /var/ossec/etc/shared\n' > /entrypoint-scripts/01-init-shared.sh && \
    chmod +x /entrypoint-scripts/01-init-shared.sh
